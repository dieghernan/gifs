  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "fires",
      "name": "fires",
      "description": "Una fila por incendio registrado, con fire_id estable. EGIF tiene prioridad en registros vinculados; los demás conservan informes o avances y su estado de conciliación. Hay casos pendientes. Los campos vacíos representan información desconocida o no aplicable; no se rellenan con cero. Las coordenadas son una ubicación de referencia, no un perímetro.",
      "key": {
        "@id": "fires/fire_id"
      },
      "field": [
        {
          "@type": "cr:Field",
          "@id": "fires/prov_name",
          "name": "prov_name",
          "description": "Provincia declarada en el parte EGIF; en la vista de incendios se conserva la descripción territorial anterior cuando existe.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "gif-csv-json"
            },
            "extract": {
              "jsonPath": "$[*].prov_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "fires/cpro",
          "name": "cpro",
          "description": "Código de provincia de dos dígitos, como texto. En partes procede del número de parte; en incendios identifica la provincia de referencia.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "gif-csv-json"
            },
            "extract": {
              "jsonPath": "$[*].cpro"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "fires/munic_name",
          "name": "munic_name",
          "description": "Municipio de origen declarado en EGIF; puede indicar Portugal u otra provincia. En la vista de incendios se conserva la descripción territorial de referencia anterior.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "gif-csv-json"
            },
            "extract": {
              "jsonPath": "$[*].munic_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "fires/cmun",
          "name": "cmun",
          "description": "Código municipal de tres dígitos, como texto. Vacío si el nombre declarado no puede vincularse inequívocamente al diccionario municipal.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "gif-csv-json"
            },
            "extract": {
              "jsonPath": "$[*].cmun"
